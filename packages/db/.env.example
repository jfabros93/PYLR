# Connection used by drizzle-kit and by migrate.ts/seed.ts.
# Must be a role that OWNS the schema (can run DDL) — typically a superuser
# or the database owner in local dev. The app itself never connects with
# this role; see DATABASE_URL_APP below.
DATABASE_URL=postgres://postgres@localhost:5432/pylr_dev

# Connection the NestJS API uses at runtime. Must be the `pylr_app` role
# created by migrations/0002_roles.sql — a non-owner, non-superuser,
# non-BYPASSRLS role, which is what makes Postgres actually enforce the
# Row-Level Security policies from migrations/0001_rls.sql.
DATABASE_URL_APP=postgres://pylr_app:pylr_app_dev_password@localhost:5432/pylr_dev

# Connection for privileged system tasks that legitimately need to act
# across tenants (Clerk webhook user sync, platform admin tooling). Uses
# the `pylr_system` BYPASSRLS role from migrations/0002_roles.sql.
# Never expose this to a request path that takes tenant-scoped input.
DATABASE_URL_SYSTEM=postgres://pylr_system:pylr_system_dev_password@localhost:5432/pylr_dev
